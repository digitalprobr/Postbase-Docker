# ─── Database ──────────────────────────────────────────────────────────────────
# Main connection string for the platform's internal _postbase schema.
# (Inside docker compose, the app overrides this with host "postgres".)
DATABASE_URL="postgresql://postbase:postbase@localhost:5432/postbase"

POSTGRES_USER="postbase"
POSTGRES_PASSWORD="postbase"
POSTGRES_DB="postbase"

# Optional: host port to map Postgres to (defaults to 5432)
POSTGRES_PORT=5432

# Optional: host port to map the app to (defaults to 3000)
APP_PORT=3000

# ─── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign Postbase JWTs. Generate with:
#   openssl rand -base64 32
POSTBASE_JWT_SECRET="generate-a-long-random-secret-here"

# Auth.js secret (required for dashboard login). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Storage ──────────────────────────────────────────────────────────────────
# Configure a storage backend per-project in the dashboard
# (Cloudflare R2, AWS S3, Backblaze B2, etc.). No default backend required.

# ─── Feature Flags & Settings ─────────────────────────────────────────────────
# ENABLE_EMAILS=false
# LOG_LEVEL="info"
