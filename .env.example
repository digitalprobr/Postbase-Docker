# ─── Database ──────────────────────────────────────────────────────────────────
# TWO MODES — the entrypoint picks one automatically:
#
#   • EMBEDDED (default) — PostgreSQL 18 runs inside the container. Leave
#     POSTGRES_URL/DATABASE_URL unset (or pointing at loopback) and the superuser
#     plus the application database are created on first start from the
#     POSTGRES_USER/PASSWORD/DB values below.
#
#   • EXTERNAL — set POSTGRES_URL to YOUR OWN PostgreSQL. The embedded server is
#     then skipped, the schema + migrations are applied to that database, and
#     only the app runs.
POSTGRES_URL="postgresql://postbase:postbase@127.0.0.1:5432/postbase"
#
#   IMPORTANT: 127.0.0.1 inside a container is the container itself, so a
#   loopback POSTGRES_URL keeps using the embedded database. To point at a real
#   external server, use a host the container can reach. If PostgreSQL runs on
#   the Docker host, use host.docker.internal (docker-compose already adds the
#   extra_hosts mapping for it):
#
#     POSTGRES_URL="postgresql://postbase:secret@host.docker.internal:5432/postbase"
#
# Only used in EMBEDDED mode (ignored when POSTGRES_URL targets an external host).
POSTGRES_USER="postbase"
POSTGRES_PASSWORD="postbase"
POSTGRES_DB="postbase"

# Optional: host port to map the app to (defaults to 3000)
# APP_PORT=3000

# ─── Authentication ────────────────────────────────────────────────────────────
# Secret key used to sign Postbase JWTs. Generate with:
#   openssl rand -base64 32
POSTBASE_JWT_SECRET="generate-a-long-random-secret-here"

# Auth.js secret (required for dashboard login). Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Storage ──────────────────────────────────────────────────────────────────
# Configure a storage backend per-project in the dashboard
# (Cloudflare R2, AWS S3, Backblaze B2, etc.). No default backend required.

# ─── Feature Flags & Settings ─────────────────────────────────────────────────
# ENABLE_EMAILS=false
# LOG_LEVEL="info"
